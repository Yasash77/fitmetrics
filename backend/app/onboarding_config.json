       "value": "cardio_fitness",
       "label": "Cardiovascular fitness"
      },
      {
       "value": "endurance",
       "label": "Endurance"
      },
      {
       "value": "general_health",
       "label": "General health"
      },
      {
       "value": "athletic_performance",
       "label": "Athletic performance"
      },
      {
       "value": "hyrox",
       "label": "HYROX preparation"
      },
      {
       "value": "sport_conditioning",
       "label": "Sport-specific conditioning"
      },
      {
       "value": "swimming",
       "label": "Swimming improvement"
      },
      {
       "value": "running",
       "label": "Running improvement"
      },
      {
       "value": "mobility",
       "label": "Mobility & flexibility"
      }
