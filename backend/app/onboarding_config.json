      {
       "value": "intermediate",
       "label": "Intermediate — 6 months to 3 years, consistent"
      },
      {
       "value": "advanced",
       "label": "Advanced — 3+ years, structured training"
      },
      {
       "value": "returning",
       "label": "Returning after a break"
      }
     ]
    },
    {
     "id": "breakMonths",
     "label": "How long was the break?",
     "type": "select",
     "required": true,
