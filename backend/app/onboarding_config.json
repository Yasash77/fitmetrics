       "value": "custom",
       "label": "Until a specific date"
      }
     ]
    },
    {
     "id": "targetDate",
     "label": "Target date",
     "type": "date",
     "required": true,
     "future": true,
     "maxWeeks": 52,
     "showIf": {
      "field": "timeline",
      "equals": "custom"
     }
    }
   ]
  },
  {
   "id": "experience",
   "title": "Experience",
   "description": "Be honest — plans that start at the right level are the ones people stick to.",
   "fields": [
    {
     "id": "experienceLevel",
     "label": "Training experience",
     "type": "cards",
     "required": true,
     "options": [
      {
       "value": "beginner",
       "label": "Beginner — new or under 6 months"
