{
 "version": 1,
 "disclaimer": "FitPulse provides general fitness guidance, not medical advice. If you are pregnant, have a heart, lung or metabolic condition, an injury, or any symptom such as chest pain, dizziness or unusual breathlessness during exercise, talk to a qualified healthcare professional before starting or changing a programme. Stop any exercise that causes pain.",
 "steps": [
  {
   "id": "basics",
   "title": "About you",
   "description": "Used to size training volume and to estimate your energy needs. Stored privately in your account.",
   "fields": [
    {
     "id": "dateOfBirth",
     "label": "Date of birth",
     "type": "date",
     "required": true,
     "help": "FitPulse is for people aged 16 and over."
    },
    {
     "id": "sex",
     "label": "Sex used for energy equations",
     "type": "radio",
     "required": true,
     "options": [
      {
       "value": "female",
       "label": "Female"
      },
      {
       "value": "male",
       "label": "Male"
      },
      {
       "value": "not_specified",
       "label": "Prefer not to say"
      }
     ],
     "help": "Only used by the calorie equations. If you prefer not to say, energy estimates are skipped."
    },
    {
     "id": "units",
     "label": "Units",
     "type": "radio",
     "required": true,
     "default": "metric",
     "options": [
      {
       "value": "metric",
       "label": "Metric (cm, kg)"
      },
      {
       "value": "imperial",
       "label": "Imperial (ft/in, lb)"
      }
     ]
    },
    {
     "id": "heightCm",
     "label": "Height",
     "type": "number",
     "unitKind": "height",
     "required": true,
     "min": 120,
     "max": 230,
     "step": 0.5,
     "unit": "cm"
    },
    {
     "id": "weightKg",
     "label": "Weight",
     "type": "number",
     "unitKind": "weight",
     "required": true,
     "min": 30,
     "max": 300,
     "step": 0.1,
     "unit": "kg"
    },
    {
     "id": "activityLevel",
     "label": "Day-to-day activity outside training",
     "type": "select",
     "required": true,
     "options": [
      {
       "value": "sedentary",
       "label": "Mostly sitting"
      },
      {
       "value": "light",
       "label": "Lightly active"
      },
      {
       "value": "moderate",
       "label": "Moderately active"
      },
      {
       "value": "active",
       "label": "Active job / lots of walking"
      },
      {
       "value": "very_active",
       "label": "Very physical job"
      }
     ]
    },
    {
     "id": "bodyFatPct",
     "label": "Body fat % (optional)",
     "type": "number",
     "min": 3,
     "max": 60,
     "step": 0.1,
     "unit": "%",
     "help": "Only if you have a recent measurement. Leave blank otherwise."
    },
    {
     "id": "restingHr",
     "label": "Resting heart rate (optional)",
     "type": "number",
     "min": 30,
     "max": 120,
     "step": 1,
     "unit": "bpm",
     "help": "Lets workout heart-rate data be analysed by FitMetrics."
    }
