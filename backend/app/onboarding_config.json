       "fat_loss",
       "muscle_gain",
       "recomposition"
      ]
     },
     "help": "A safe rate is roughly 0.25–1% of body weight per week. FitPulse will flag targets that are too fast."
    },
    {
     "id": "targetEvent",
     "label": "Event or race you're training for (optional)",
     "type": "text",
     "maxLength": 120,
     "placeholder": "e.g. HYROX Open in March, local 10K",
     "showIf": {
      "field": "primaryGoal",
      "in": [
       "hyrox",
       "running",
       "swimming",
       "endurance",
       "athletic_performance",
       "sport_conditioning"
      ]
     }
    },
    {
